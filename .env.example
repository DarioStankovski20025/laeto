# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. NEVER prefix with NEXT_PUBLIC_. Used only by
# src/lib/supabase/admin.ts (the feed and scraper callback routes) — it
# bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
# Absolute base URL of this deployment, used to build the callback URL used
# in local mock mode (e.g. https://tracker.laeto.example). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── External report service ──────────────────────────────────────────────────
# This app does NOT push the full catalog anywhere and has no cron. The
# external report service PULLS it by calling GET /api/reports/feed on its
# own schedule, authenticating with this secret as `Authorization: Bearer
# <value>`. Response is a link-only JSON array: one
# { our_product, competitors: [...], email } entry per notify-enabled
# product that has an Amazon URL and at least one competitor.
REPORTS_FEED_SECRET=change-me-to-a-long-random-value

# The single-product "Check now" button still PUSHES — put the report
# service's manual-check endpoint here. Payload is the same link-only shape
# as one feed entry (a bare object, not wrapped in an array).
MANUAL_CHECK_URL=https://reports.laeto.example/manual-check
# Sent as `Authorization: Bearer <value>` on that outbound request.
MANUAL_CHECK_SECRET=change-me-to-a-different-long-random-value

# Sent by the report service as `Authorization: Bearer <value>` when it
# calls back to POST /api/reports/callback to report processing/completed/
# failed. Must differ from the two secrets above. The run id to report
# against travels as the `X-Report-Run-Id` header on both the feed response
# and the manual-check request — never inside the link-only JSON body.
SCRAPER_CALLBACK_SECRET=change-me-to-a-different-long-random-value-again
# Outbound request timeout for the manual-check push, in milliseconds. Optional.
SCRAPER_TIMEOUT_MS=15000

# When "true", the manual-check push makes no outbound call — a realistic
# fake acknowledgement is returned instead, and a short mock processing ->
# completed callback sequence fires a few seconds later against the REAL
# callback secret, so the whole UI flow (including polling) can be
# exercised without a live report service. GET /api/reports/feed always
# just answers from the database regardless of this flag — there's nothing
# to mock on a pull. Refuses to engage in a production NODE_ENV unless
# SCRAPER_MOCK_MODE_FORCE_PRODUCTION=true is also set — never enable that in
# a real deployment.
SCRAPER_MOCK_MODE=true
# SCRAPER_MOCK_MODE_FORCE_PRODUCTION=false

# ── Optional ────────────────────────────────────────────────────────────────
# Public self-service signup is off unless explicitly enabled. This is a
# private, single-tenant application by default.
# NEXT_PUBLIC_ALLOW_SIGNUP=false
