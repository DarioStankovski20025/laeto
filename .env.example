# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. NEVER prefix with NEXT_PUBLIC_. Used only by
# src/lib/supabase/admin.ts (the daily cron and scraper callback routes) —
# it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
# Absolute base URL of this deployment, used to build the callback URL sent
# to the scraper (e.g. https://tracker.laeto.example). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── External PHP scraper ─────────────────────────────────────────────────────
# Endpoint the PHP scraper exposes to receive a job payload.
SCRAPER_API_URL=https://scraper.laeto.example/api/jobs
# Sent as `Authorization: Bearer <value>` on every outbound request.
SCRAPER_API_SECRET=change-me-to-a-long-random-value
# Sent by the PHP worker as `Authorization: Bearer <value>` when it calls
# back to POST /api/reports/callback. Must differ from SCRAPER_API_SECRET.
SCRAPER_CALLBACK_SECRET=change-me-to-a-different-long-random-value
# Outbound request timeout to the scraper, in milliseconds. Optional.
SCRAPER_TIMEOUT_MS=15000

# When "true", no outbound call is made — a realistic fake acknowledgement is
# returned instead, and a short mock processing -> completed callback
# sequence fires a few seconds later against the REAL callback secret, so the
# whole UI flow (including polling) can be exercised without a live scraper.
# Refuses to engage in a production NODE_ENV unless
# SCRAPER_MOCK_MODE_FORCE_PRODUCTION=true is also set — never enable that in
# a real deployment.
SCRAPER_MOCK_MODE=true
# SCRAPER_MOCK_MODE_FORCE_PRODUCTION=false

# ── Cron ─────────────────────────────────────────────────────────────────────
# Authorizes GET /api/cron/daily-report as `Authorization: Bearer <value>`.
CRON_SECRET=change-me-to-a-long-random-value
# "hourly" (default) selects only accounts whose LOCAL hour matches their
# preferred_report_time, so the setting genuinely drives delivery — this
# requires the route to run every hour (see vercel.json). Set to "daily" on a
# platform limited to a single once-a-day cron invocation; in that mode every
# enabled account is sent at whatever fixed hour the cron itself runs, and
# preferred_report_time is not honored (the Settings UI disables that field
# and explains why when NEXT_PUBLIC_CRON_MODE is also set to "daily").
CRON_MODE=hourly
# NEXT_PUBLIC_CRON_MODE=hourly

# ── Optional ────────────────────────────────────────────────────────────────
# Public self-service signup is off unless explicitly enabled. This is a
# private, single-tenant application by default.
# NEXT_PUBLIC_ALLOW_SIGNUP=false
